VITE_UPLOAD_API_URL=
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# Public Reown Project ID. Allowlist the RareCognos frontend origin in Reown.
VITE_WALLETCONNECT_PROJECT_ID=
VITE_PUBLIC_APP_URL=https://rarecognos.com
VITE_GOOGLE_CLIENT_ID=

# Leave VITE_UPLOAD_API_URL empty to use the same-origin /api/upload route.
# Set PINATA_JWT on the server only (Vercel env). Never prefix it with VITE_.
# UPLOAD_ALLOWED_ORIGINS=https://rarecognos.com

# Deploying creator-owned editions also requires the verified factory address.
VITE_DROP_FACTORY=

# Server-only: durable single-use upload challenges and 30 uploads/wallet/day.
# Configure BOTH in Vercel to enforce limits across serverless instances.
# Without these, upload protection is limited to each individual server process.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
